DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DB"
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── AI (OpenAI) ───────────────────────────────────────────────────────────────
# Used by the nightly CRON job to generate professor Quick Take summaries.
# If unset, the app falls back to a stats-based summary (no API calls made).
# If unset, the app falls back to a stats-based summary (no API calls made)
OPENAI_API_KEY=""

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Used to send .edu verification emails, professor claim emails, and reply
# approval notifications.  If unset, emails are printed to the console.
RESEND_API_KEY=""
# The "from" address for all transactional emails.
EMAIL_FROM="ClassRack <noreply@classrack.app>"

# ── File uploads (UploadThing) ────────────────────────────────────────────────
# Used by professors to upload syllabi (PDF, max 8 MB).
# Get your token at https://uploadthing.com/dashboard → API Keys.
UPLOADTHING_TOKEN=""

# ── CRON security ─────────────────────────────────────────────────────────────
# A long, random secret used to authorise calls to /api/cron/* endpoints.
# Set the same value in Vercel's CRON configuration (vercel.json headers).
# Generate with: openssl rand -hex 32
CRON_SECRET=""

# ── Admin access ──────────────────────────────────────────────────────────────
# Admin status is stored on User.isAdmin (DB column), not an env var. Existing
# admins can grant/revoke access to other users at /admin/users.
#
# To bootstrap the first admin, set isAdmin=true directly on a User row, e.g.:
#   UPDATE "User" SET "isAdmin" = true WHERE email = 'you@example.com';
#
# If migrating from a previous ADMIN_EMAILS setup, run
# `ADMIN_EMAILS="alice@example.com,bob@example.com" npm run admin:backfill`
# once after applying migrations to carry those emails over.
