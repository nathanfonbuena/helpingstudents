generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  PROFESSOR
}

enum ThemePreference {
  LIGHT
  DARK
}

enum ReviewVoteType {
  UP
  DOWN
}

enum MaterialStatus {
  DRAFT
  PENDING
  APPROVED
}

enum SchoolType {
  TWO_YEAR
  FOUR_YEAR
}

enum VerificationStatusType {
  PENDING
  VERIFIED
  EXPIRED
  REVOKED
}

enum ProfessorClaimMethod {
  EMAIL
  SSO
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id            String          @id @default(cuid())
  email         String          @unique
  name          String?
  image         String?
  emailVerified DateTime?
  verified      Boolean         @default(false)
  major         String?
  year          String?
  passwordHash  String?
  theme         ThemePreference @default(LIGHT)
  role          UserRole
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  schools                      UserSchool[]
  reviewsWritten               Review[]                @relation("reviews_written")
  reviewsReceived              Review[]                @relation("reviews_received")
  schoolReviews                SchoolReview[]
  courses                      Course[]
  coursesCreated               Course[]                @relation("courses_created")
  tags                         TagOnProfessor[]
  departments                  DepartmentOnProfessor[]
  materials                    Material[]              @relation("materials_professor")
  materialsAuthored            Material[]              @relation("materials_authored")
  following                    UserFollow[]            @relation("user_following")
  followers                    UserFollow[]            @relation("user_followers")
  scheduleEntries              ScheduleEntry[]
  professorProfileViews        ProfessorProfileView[]  @relation("professor_profile_views")
  professorProfileViewsCreated ProfessorProfileView[]  @relation("professor_profile_views_viewer")
  reviewViewsCreated           ReviewView[]            @relation("review_views_viewer")
  savedCourses                 SavedCourse[]
  materialViews                MaterialView[]          @relation("material_views_viewer")
  materialSaves                MaterialSave[]
  notifications                Notification[]
  accounts                     Account[]
  sessions                     Session[]
  responses                    ReviewResponse[]
  reviewVotes                  ReviewVote[]
  schoolReviewVotes            SchoolReviewVote[]
  verificationStatus           VerificationStatus?
  professorProfile             ProfessorProfile?
  reviewSummary                ReviewSummary?
  courseMetadata               CourseMetadata[]

  // A professor who signed up and claimed an existing seeded profile links here.
  // The relation is 1-to-1: one existing professor can only be claimed by one user.
  claimedProfessorId           String?          @unique
  claimedProfessor             User?            @relation("ProfessorOwnership", fields: [claimedProfessorId], references: [id])
  claimedByUser                User?            @relation("ProfessorOwnership")
}

model School {
  id             String      @id @default(cuid())
  name           String
  nickname       String?
  slug           String      @unique
  unitId         String?     @unique
  city           String?
  state          String?
  zip            String?
  type           SchoolType?
  website        String?
  latitude       Float?
  longitude      Float?
  enrollmentSize Int?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  users       UserSchool[]
  departments Department[]
  courses     Course[]
  reviews     SchoolReview[]
}

model UserSchool {
  userId    String
  schoolId  String
  role      UserRole
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  school School @relation(fields: [schoolId], references: [id])

  @@id([userId, schoolId])
}

model Review {
  id                  String   @id @default(cuid())
  rating              Int
  difficulty          Int
  expertise           Int
  enjoyability        Int
  clarity             Int
  body                String
  helpfulUp           Int      @default(0)
  helpfulDown         Int      @default(0)
  isImport            Boolean  @default(false)
  wouldTakeAgain      Boolean?
  forCredit           Boolean?
  attendanceMandatory Boolean?
  textbookRequired    Boolean?
  onlineClass         Boolean?
  grade               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  studentId   String
  professorId String

  student   User            @relation("reviews_written", fields: [studentId], references: [id])
  professor User            @relation("reviews_received", fields: [professorId], references: [id])
  response  ReviewResponse?
  votes     ReviewVote[]
  views     ReviewView[]

  @@index([professorId])
  @@index([studentId])
  @@index([createdAt])
}

model ReviewVote {
  id        String         @id @default(cuid())
  reviewId  String
  userId    String
  vote      ReviewVoteType
  createdAt DateTime       @default(now())

  review Review @relation(fields: [reviewId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([reviewId, userId])
  @@index([userId])
  @@index([reviewId])
}

model SchoolReview {
  id            String   @id @default(cuid())
  overall       Int
  reputation    Int
  opportunities Int
  clubs         Int
  safety        Int
  location      Int
  facilities    Int
  happiness     Int
  internet      Int
  food          Int
  social        Int
  body          String
  helpfulUp     Int      @default(0)
  helpfulDown   Int      @default(0)
  isImport      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  studentId String
  schoolId  String

  student User               @relation(fields: [studentId], references: [id])
  school  School             @relation(fields: [schoolId], references: [id])
  votes   SchoolReviewVote[]

  @@index([schoolId])
  @@index([studentId])
}

model SchoolReviewVote {
  id        String         @id @default(cuid())
  reviewId  String
  userId    String
  vote      ReviewVoteType
  createdAt DateTime       @default(now())

  review SchoolReview @relation(fields: [reviewId], references: [id])
  user   User         @relation(fields: [userId], references: [id])

  @@unique([reviewId, userId])
  @@index([userId])
  @@index([reviewId])
}

model ReviewResponse {
  id        String           @id @default(cuid())
  body      String
  status    ModerationStatus @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  reviewId    String @unique
  professorId String

  review    Review @relation(fields: [reviewId], references: [id])
  professor User   @relation(fields: [professorId], references: [id])

  @@index([professorId])
  @@index([status])
}

model Tag {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  professors TagOnProfessor[]
}

model TagOnProfessor {
  professorId String
  tagId       String
  createdAt   DateTime @default(now())

  professor User @relation(fields: [professorId], references: [id])
  tag       Tag  @relation(fields: [tagId], references: [id])

  @@id([professorId, tagId])
  @@index([tagId])
}

model Department {
  id        String   @id @default(cuid())
  name      String
  slug      String
  code      String?
  schoolId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school     School                  @relation(fields: [schoolId], references: [id])
  professors DepartmentOnProfessor[]
  courses    Course[]

  @@unique([schoolId, slug])
  @@index([schoolId])
}

model Course {
  id           String   @id @default(cuid())
  name         String
  courseNumber String
  description  String?
  credits      Int?
  schoolId     String
  professorId  String?
  departmentId String?
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school          School          @relation(fields: [schoolId], references: [id])
  professor       User?           @relation(fields: [professorId], references: [id])
  department      Department?     @relation(fields: [departmentId], references: [id])
  createdBy       User?           @relation("courses_created", fields: [createdById], references: [id])
  scheduleEntries ScheduleEntry[]
  materials       Material[]
  savedCourses    SavedCourse[]
  metadata        CourseMetadata?

  @@unique([schoolId, courseNumber])
  @@index([schoolId])
  @@index([professorId])
  @@index([departmentId])
  @@index([createdById])
}

model ProfessorProfileView {
  id          String   @id @default(cuid())
  professorId String
  viewerId    String
  viewedOn    DateTime
  createdAt   DateTime @default(now())

  professor User @relation("professor_profile_views", fields: [professorId], references: [id])
  viewer    User @relation("professor_profile_views_viewer", fields: [viewerId], references: [id])

  @@unique([professorId, viewerId, viewedOn])
  @@index([professorId])
  @@index([viewerId])
}

model ReviewView {
  id        String   @id @default(cuid())
  reviewId  String
  viewerId  String
  viewedOn  DateTime
  createdAt DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id])
  viewer User   @relation("review_views_viewer", fields: [viewerId], references: [id])

  @@unique([reviewId, viewerId, viewedOn])
  @@index([reviewId])
  @@index([viewerId])
}

model Material {
  id          String         @id @default(cuid())
  title       String
  content     String
  status      MaterialStatus @default(PENDING)
  term        String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  professorId String
  uploaderId  String
  courseId    String?

  professor User           @relation("materials_professor", fields: [professorId], references: [id])
  uploader  User           @relation("materials_authored", fields: [uploaderId], references: [id])
  course    Course?        @relation(fields: [courseId], references: [id])
  views     MaterialView[]
  saves     MaterialSave[]

  @@index([professorId])
  @@index([uploaderId])
  @@index([courseId])
}

model MaterialView {
  id         String   @id @default(cuid())
  materialId String
  viewerId   String
  viewedOn   DateTime
  createdAt  DateTime @default(now())

  material Material @relation(fields: [materialId], references: [id])
  viewer   User     @relation("material_views_viewer", fields: [viewerId], references: [id])

  @@unique([materialId, viewerId, viewedOn])
  @@index([materialId])
  @@index([viewerId])
}

model MaterialSave {
  id         String   @id @default(cuid())
  materialId String
  userId     String
  createdAt  DateTime @default(now())

  material Material @relation(fields: [materialId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([materialId, userId])
  @@index([materialId])
  @@index([userId])
}

model DepartmentOnProfessor {
  departmentId String
  professorId  String
  createdAt    DateTime @default(now())

  department Department @relation(fields: [departmentId], references: [id])
  professor  User       @relation(fields: [professorId], references: [id])

  @@id([departmentId, professorId])
  @@index([professorId])
}

model UserFollow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("user_following", fields: [followerId], references: [id])
  following User @relation("user_followers", fields: [followingId], references: [id])

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model ScheduleEntry {
  id           String   @id @default(cuid())
  userId       String
  courseId     String
  term         String?
  meetingTimes String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId, term])
  @@index([userId])
  @@index([courseId])
}

model SavedCourse {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  message   String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────────────────────────────────────
// Pillar 1: Student Verification
// FERPA note: eduEmail is stored server-side only. tokenHash is a one-way hash
// and the raw token is never persisted. verified flag on User is never exposed
// to professor-facing API responses.
// ─────────────────────────────────────────────────────────────────────────────

model VerificationStatus {
  id          String                 @id @default(cuid())
  userId      String                 @unique
  eduEmail    String
  // One-way hash of the verification token — raw token is never stored
  tokenHash   String
  status      VerificationStatusType @default(PENDING)
  verifiedAt  DateTime?
  expiresAt   DateTime
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([eduEmail])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Pillar 3: Professor Portal
// ─────────────────────────────────────────────────────────────────────────────

model ProfessorProfile {
  id                 String               @id @default(cuid())
  professorId        String               @unique
  isClaimed          Boolean              @default(false)
  claimMethod        ProfessorClaimMethod?
  claimedAt          DateTime?
  bio                String?
  officialEmail      String?
  // Syllabus storage (UploadThing CDN URL)
  syllabusUrl        String?
  syllabusFilename   String?
  syllabusUploadedAt DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  professor User @relation(fields: [professorId], references: [id])
}

// ─────────────────────────────────────────────────────────────────────────────
// Pillar 2: AI Sentiment Engine
// Caches nightly LLM-generated summaries to avoid re-running on every page load
// ─────────────────────────────────────────────────────────────────────────────

model ReviewSummary {
  id                String   @id @default(cuid())
  professorId       String   @unique
  quickTake         String   // AI-generated one-paragraph overview
  workload          String?  // Workload summary sentence
  gradingDifficulty String?  // Grading difficulty summary sentence
  teachingStyle     String?  // Teaching style summary sentence
  sentimentScore    Float?   // 0.0 (very negative) – 1.0 (very positive)
  reviewCount       Int      @default(0) // # reviews used for this summary
  modelUsed         String?  // e.g. "gpt-4o-mini"
  lastUpdated       DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  professor User @relation(fields: [professorId], references: [id])

  @@index([lastUpdated])
}

// ─────────────────────────────────────────────────────────────────────────────
// Course Metadata (grade distributions, tags, class size)
// ─────────────────────────────────────────────────────────────────────────────

model CourseMetadata {
  id                String   @id @default(cuid())
  courseId          String   @unique
  professorId       String?
  // JSON array of tag strings, e.g. ["Lab-based", "Writing Intensive"]
  tags              String[]
  // JSON object: {"A": 35, "B": 40, "C": 20, "D": 3, "F": 2}
  gradeDistribution Json?
  classSize         Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  course    Course @relation(fields: [courseId], references: [id])
  professor User?  @relation(fields: [professorId], references: [id])

  @@index([professorId])
}
